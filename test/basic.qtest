#!/usr/bin/env qore

# sqlite3 test script

%modern

%requires Util
%requires QUnit

%exec-class Sqlite3BasicTest

class Sqlite3BasicTest inherits QUnit::Test {
    public {
        Datasource ds;

        const MyOpts = Opts + {
            "db": "d,db=s",
            "enc": "e,encoding=s",
        };

        const OptionColumn = 22;
    }

    constructor() : QUnit::Test("Dir", "1.0", \ARGV, MyOpts) {
        ds = new Datasource("sqlite3", "", "", m_options.db ?? "test.sqlite", m_options.enc);

        if (m_options.verbose > 2) {
            printf("Sqlite3 version used: %s\n", ds.getServerVersion());
        }

        addTestCase("BasicTest", \basicTest());
        addTestCase("NegativeTests", \negativeTests());
        addTestCase("CornerCaseTests", \cornerCaseTests());
        addTestCase("NullHandlingTests", \nullHandlingTests());
        addTestCase("LargeIntegerTests", \largeIntegerTests());
        addTestCase("SandboxFilesystemTest", \sandboxFilesystemTest());

        set_return_value(main());
    }

    basicTest() {
        execIgnore("drop table foo");
        execIgnore("drop view v_foo");

        auto result = ds.exec("create table foo (
    id integer primary key autoincrement,
    txt text,
    int integer,
    dbl real,
    blb blob,
    bol integer
)");
        on_exit execIgnore("drop table foo");
        assertEq(0, result);

        result = ds.exec("create view %s as select * from %s;", "v_foo", "foo");
        on_exit execIgnore("drop view v_foo");
        assertEq(0, result);

        result = ds.commit();
        assertNothing(result);

        binary dat = File::readBinaryFile(get_script_dir() + "blob.png");
        {
            bool b;
            for (int i = 0; i < 50; i++) {
                b = (i % 2 == 0);
                result = ds.exec("insert into foo (txt, int, dbl, blb, bol) values (%v, %v, %v, %v, %v)",
                    "lorem ipsum", rand(), rand()/1.0, dat, b);
                assertEq(1, result);
            }
        }
        {
            Datasource ds1 = ds.copy();
            assertEq((), ds1.selectRows("select * from foo"));
        }

        result = ds.commit();
        assertNothing(result);

        result = ds.select("select * from foo order by id");
        assertEq(50, result.txt.size());
        map assertEq(dat, $1), result.blb;
        map assertTrue($1 >= 0 && $1 <= 1), result.bol;
        map assertEq((Type::String, Type::Int), ($1.txt.type(), $1."int".type())), result.contextIterator();
        map assertEq($#, $1 - 1), result.id;

        result = ds.select("select * from %s order by id;", "v_foo");
        assertEq(50, result.txt.size());
        map assertEq(dat, $1), result.blb;
        map assertTrue($1 >= 0 && $1 <= 1), result.bol;
        map assertEq((Type::String, Type::Int), ($1.txt.type(), $1."int".type())), result.contextIterator();
        map assertEq($#, $1 - 1), result.id;

        result = ds.selectRows("select * from foo order by id;");
        assertEq(50, result.size());
        map assertEq(dat, $1.blb), result;
        map assertTrue($1.bol >= 0 && $1.bol <= 1), result;
        map assertEq((Type::String, Type::Int), ($1.txt.type(), $1."int".type())), result;
        map assertEq($#, $1.id - 1), result;

        result = ds.selectRows("select * from %s;", "v_foo");
        assertEq(50, result.size());
        map assertEq(dat, $1.blb), result;
        map assertTrue($1.bol >= 0 && $1.bol <= 1), result;
        map assertEq((Type::String, Type::Int), ($1.txt.type(), $1."int".type())), result;
        map assertEq($#, $1.id - 1), result;

        result = ds.exec("select * from foo where %s < %v", "id", 6);
        assertEq(5, result.txt.size());
        map assertEq(dat, $1), result.blb;
        map assertTrue($1 >= 0 && $1 <= 1), result.bol;
        map assertEq((Type::String, Type::Int), ($1.txt.type(), $1."int".type())), result.contextIterator();
        map assertEq($#, $1 - 1), result.id;

        # Test 10 - select from table via select() with bindings
        result = ds.select("select * from foo where %s < %v", "id", 6);
        assertEq(5, result.txt.size());
        map assertEq(dat, $1), result.blb;
        map assertTrue($1 >= 0 && $1 <= 1), result.bol;
        map assertEq((Type::String, Type::Int), ($1.txt.type(), $1."int".type())), result.contextIterator();
        map assertEq($#, $1 - 1), result.id;

        # Test 11 - select from table via selectRows() with bindings
        result = ds.selectRows("select * from foo where %s < %v", "id", 6);
        assertEq(5, result.size());
        map assertEq(dat, $1.blb), result;
        map assertTrue($1.bol >= 0 && $1.bol <= 1), result;
        map assertEq((Type::String, Type::Int), ($1.txt.type(), $1."int".type())), result;
        map assertEq($#, $1.id - 1), result;

        # Test 12 - pragma call - with returning value
        result = ds.exec("PRAGMA encoding");
        assertEq(1, result.size());
        assertEq(1, result.encoding.lsize());
        assertEq("UTF-8", result.encoding[0]);
        result = ds.exec("PRAGMA table_info(%s);", "foo");
        assertEq(6, result.size());

        # Test 13 - pragma call - settings with no returns
        result = ds.exec("PRAGMA count_changes=%s", 1);
        assertEq(1, result);

        # Test 14 - execRaw() calls
        result = ds.execRaw("select * from foo where id = 6");
        assertEq({
            "id": 6,
            "txt": "lorem ipsum",
            "blb": dat,
            "bol": 0,
        }, (map {$1.key: $1.value[0]}, result.pairIterator(), $1.key != "int" && $1.key != "dbl"));

        {
            AbstractSQLStatement stmt = ds.getSQLStatement();
            on_error stmt.rollback();
            on_success stmt.commit();
            stmt.prepare("select id, txt, blb, bol from foo where id = 6");
            assertEq(True, stmt.next());
            assertEq({
                "id": 6,
                "txt": "lorem ipsum",
                "blb": dat,
                "bol": 0,
            }, stmt.fetchRow());
        }

        {
            AbstractSQLStatement stmt = ds.getSQLStatement();
            on_error stmt.rollback();
            on_success stmt.commit();
            stmt.prepare("select id, txt, int, blb, bol from foo order by id");
            int offset = 0;
            while (*hash<auto> h = stmt.fetchColumns(10)) {
                assertEq(10, h.id.size());

                map assertEq(dat, $1), h.blb;
                map assertTrue($1 >= 0 && $1 <= 1), h.bol;
                map assertEq((Type::String, Type::Int), ($1.txt.type(), $1."int".type())), h.contextIterator();
                map assertEq($# + offset, $1 - 1), h.id;
                offset += 10;
            }
        }

        {
            AbstractSQLStatement stmt = ds.getSQLStatement();
            on_error stmt.rollback();
            on_success stmt.commit();
            stmt.prepare("select id, txt, int, blb, bol from foo order by id");
            int offset = 0;
            while (*list<hash<auto>> l = stmt.fetchRows(10)) {
                assertEq(10, l.size());

                map assertEq(dat, $1.blb), l;
                map assertTrue($1.bol >= 0 && $1.bol <= 1), l;
                map assertEq((Type::String, Type::Int), ($1.txt.type(), $1."int".type())), l;
                map assertEq($# + offset, $1.id - 1), l;
                offset += 10;
            }
        }

        {
            AbstractSQLStatement stmt = ds.getSQLStatement();
            on_error stmt.rollback();
            on_success stmt.commit();
            stmt.prepare("update foo set int = %v where id = 1");
            stmt.bind(rand());
            stmt.exec();
            assertEq(1, stmt.affectedRows());
        }

        ds.rollback();
    }

    negativeTests() {
        # Create a test table for these tests
        execIgnore("drop table neg_test");
        ds.exec("create table neg_test (id integer, txt text)");
        on_exit {
            ds.rollback();
            execIgnore("drop table neg_test");
        }
        ds.commit();

        # Test invalid bind placeholder
        assertThrows("SQLITE3-PARSE-EXCEPTION", sub() {
            ds.exec("select * from neg_test where id = %z", 1);
        });

        # Test invalid bind placeholder with trailing alpha
        assertThrows("SQLITE3-PARSE-EXCEPTION", sub() {
            ds.exec("select * from neg_test where id = %va", 1);
        });

        # Test binding unsupported type (hash)
        assertThrows("SQLITE3-BIND-EXCEPTION", sub() {
            ds.exec("insert into neg_test (txt) values (%v)", {"key": "value"});
        });

        # Test invalid SQL syntax
        assertThrows("SQLITE3-EXEC", sub() {
            ds.exec("selekt * form neg_test");
        });

        # Test SQLStatement fetchRow without next()
        {
            ds.exec("insert into neg_test (id) values (1)");
            ds.commit();

            AbstractSQLStatement stmt = ds.getSQLStatement();
            on_error stmt.rollback();
            on_success stmt.commit();
            stmt.prepare("select * from neg_test");
            # Try to fetch without calling next() first
            assertThrows("SQLITE3-FETCH-ROW-ERROR", \stmt.fetchRow());
        }
    }

    cornerCaseTests() {
        execIgnore("drop table corner_test");
        ds.exec("create table corner_test (
            id integer primary key,
            txt text,
            num real,
            blb blob
        )");
        on_exit {
            ds.rollback();
            execIgnore("drop table corner_test");
        }

        # Test empty string vs NULL
        ds.exec("insert into corner_test (id, txt) values (%v, %v)", 1, "");
        ds.exec("insert into corner_test (id, txt) values (%v, %v)", 2, NULL);
        ds.commit();

        auto result = ds.selectRows("select * from corner_test order by id");
        assertEq(2, result.size());
        assertEq("", result[0].txt);  # Empty string
        assertEq(NULL, result[1].txt);  # NULL

        # Test binary data
        ds.exec("insert into corner_test (id, blb) values (%v, %v)", 3, <abcd>);
        ds.commit();

        result = ds.selectRows("select * from corner_test where id = 3");
        assertEq(1, result.size());
        assertEq(<abcd>, result[0].blb);

        # Note: Zero-length blobs in SQLite are indistinguishable from NULL
        # when using sqlite3_column_bytes(), so we don't test for that edge case

        # Test unicode/multibyte characters
        string unicode_str = "Hello 世界 🌍 émojis";
        ds.exec("insert into corner_test (id, txt) values (%v, %v)", 5, unicode_str);
        ds.commit();

        result = ds.selectRows("select txt from corner_test where id = 5");
        assertEq(unicode_str, result[0].txt);

        # Test quoted string with % - should NOT be parsed as bind placeholder
        ds.exec("insert into corner_test (id, txt) values (%v, '%v is literal')", 4);
        ds.commit();
        result = ds.selectRows("select txt from corner_test where id = 4");
        assertEq("%v is literal", result[0].txt);

        ds.rollback();
    }

    nullHandlingTests() {
        execIgnore("drop table null_test");
        ds.exec("create table null_test (
            id integer primary key,
            int_col integer,
            txt_col text,
            real_col real,
            blob_col blob
        )");
        on_exit {
            ds.rollback();
            execIgnore("drop table null_test");
        }

        # Insert NULL values for all column types
        ds.exec("insert into null_test (id, int_col, txt_col, real_col, blob_col) values (%v, %v, %v, %v, %v)",
            1, NULL, NULL, NULL, NULL);
        # Insert NOTHING values (should also become NULL)
        ds.exec("insert into null_test (id, int_col, txt_col, real_col, blob_col) values (%v, %v, %v, %v, %v)",
            2, NOTHING, NOTHING, NOTHING, NOTHING);
        ds.commit();

        auto result = ds.selectRows("select * from null_test order by id");
        assertEq(2, result.size());

        # Both NULL and NOTHING should result in NULL values
        assertEq(NULL, result[0].int_col);
        assertEq(NULL, result[0].txt_col);
        assertEq(NULL, result[0].real_col);
        assertEq(NULL, result[0].blob_col);

        assertEq(NULL, result[1].int_col);
        assertEq(NULL, result[1].txt_col);
        assertEq(NULL, result[1].real_col);
        assertEq(NULL, result[1].blob_col);

        # Test IS NULL query
        result = ds.selectRows("select count(*) as cnt from null_test where int_col is null");
        assertEq(2, result[0].cnt);

        ds.rollback();
    }

    largeIntegerTests() {
        execIgnore("drop table int_test");
        ds.exec("create table int_test (id integer primary key, big_int integer)");
        on_exit {
            ds.rollback();
            execIgnore("drop table int_test");
        }

        # Test 64-bit integer boundaries
        int max_int64 = MAXINT;               # 2^63 - 1
        int min_int64 = MININT;               # -2^63 + 1
        int large_positive = 4294967296;      # 2^32 (larger than 32-bit)
        int large_negative = -4294967296;

        ds.exec("insert into int_test (id, big_int) values (%v, %v)", 1, max_int64);
        ds.exec("insert into int_test (id, big_int) values (%v, %v)", 2, min_int64);
        ds.exec("insert into int_test (id, big_int) values (%v, %v)", 3, large_positive);
        ds.exec("insert into int_test (id, big_int) values (%v, %v)", 4, large_negative);
        ds.exec("insert into int_test (id, big_int) values (%v, %v)", 5, 0);
        ds.commit();

        auto result = ds.selectRows("select * from int_test order by id");
        assertEq(5, result.size());
        assertEq(max_int64, result[0].big_int);
        assertEq(min_int64, result[1].big_int);
        assertEq(large_positive, result[2].big_int);
        assertEq(large_negative, result[3].big_int);
        assertEq(0, result[4].big_int);

        # Verify the types are integers
        assertEq(Type::Int, result[0].big_int.type());
        assertEq(Type::Int, result[2].big_int.type());

        ds.rollback();
    }

    sandboxFilesystemTest() {
        # Test that filesystem sandbox blocks database file access outside allowed paths

        string testDbPath = "/tmp/sqlite3_sandbox_test_" + getpid() + ".db";
        on_exit {
            try { unlink(testDbPath); } catch () {}
        }

        # Create a sandboxed program with /var as root (so /tmp is outside)
        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p.loadModule("sqlite3");

        p.parse(sprintf("
            sub test_open_db() {
                Datasource ds('sqlite3', '', '', '%s');
                ds.open();
            }
        ", testDbPath), "sandbox_db_test");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        # Test that database open is blocked when file is outside sandbox
        bool caught = False;
        try {
            p.callFunction("test_open_db");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("FILESYSTEM-ACCESS-DENIED", ex.err, "Database access blocked with correct error");
        }
        assertTrue(caught, "Database access outside sandbox was blocked");

        # Test that :memory: database works even with filesystem sandbox
        Program p2(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p2.loadModule("sqlite3");

        p2.parse("
            int sub test_memory_db() {
                Datasource ds('sqlite3', '', '', ':memory:');
                ds.open();
                ds.exec('create table test (id integer)');
                ds.exec('insert into test values (42)');
                ds.commit();
                auto result = ds.selectRow('select id from test');
                ds.close();
                return result.id;
            }
        ", "sandbox_memory_db_test");
        p2.setSandboxManager(sm);

        int result = p2.callFunction("test_memory_db");
        assertEq(42, result, "In-memory database works even with filesystem sandbox");

        # Test that database access works when file is in allowed path
        SandboxManager sm3();
        sm3.setFilesystemSandboxRoot("/tmp");
        Program p3(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p3.loadModule("sqlite3");

        p3.parse(sprintf("
            int sub test_allowed_db() {
                Datasource ds('sqlite3', '', '', '%s');
                ds.open();
                ds.exec('create table test (id integer)');
                ds.exec('insert into test values (123)');
                ds.commit();
                auto result = ds.selectRow('select id from test');
                ds.close();
                return result.id;
            }
        ", testDbPath), "sandbox_allowed_db_test");
        p3.setSandboxManager(sm3);

        result = p3.callFunction("test_allowed_db");
        assertEq(123, result, "Database access inside sandbox works");
    }

    execIgnore(string sql) {
        try {
            on_error ds.rollback();
            on_success ds.commit();
            ds.vexec(sql, argv);
        } catch () {
        }
    }

    cout(auto val) {
        if (m_options.verbose > 2) {
            printf("    result: %N\n\n", val);
        }
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-d,--db=ARG", "set the DB connection (ex: \"sqlite3:x/y@file.sqlite\")", OptionColumn);
        printOption("-e,--encoding=ARG", "the character encoding to use", OptionColumn);
    }
}
